var waitForElementToDisplay = function (selector, calback, timeout = 5000, interval = 100) {
    const endTime = new Date().getTime() + timeout;

    function checkElement(callback) {
        if (FOR_WEB_CHAT_){
            var documentIframe = window.__SMC_CHAT_V2_SHADOW__;
        } else if (document.querySelector('#webform-iframe')){
            var documentIframe = document.querySelector('#webform-iframe').contentDocument;
        } else {
            var documentIframe = document;
        }
        
        var element = documentIframe.querySelectorAll(selector);
        if (element && element.length) {
            
            element = element.length == 1 ? element[0] : element;
            // console.log(`Element found with selector: ${selector}`);
            // console.log(element);
            // Element found, execute the callback
            callback(element);
        } else if (new Date().getTime() < endTime) {
            // Continue checking until timeout
            setTimeout(checkElement, interval, callback);
        } else {
            // Timeout reached, do something (optional)
        }
    }

    // Initial check
    checkElement(calback);
}
